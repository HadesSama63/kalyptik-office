index b256bac..a40dc77 100644
--- a/win-linux/CMakeLists.txt
+++ b/win-linux/CMakeLists.txt
@@ -521,6 +521,24 @@ install(DIRECTORY "${EO_CORE_OUTPUT_DIR}/"
     DESTINATION ${CMAKE_INSTALL_BINDIR}/converter
 )
 
+# Kalyptik: interface themes → uithemes/ (loaded automatically at startup)
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/res/uithemes")
+    install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/res/uithemes/"
+        DESTINATION ${CMAKE_INSTALL_BINDIR}/uithemes
+        FILES_MATCHING PATTERN "*.json"
+    )
+endif()
+
+# Kalyptik: app.ico, used by the Windows shortcuts, the uninstaller entry and
+# notifications ({app}\app.ico in package/inno/common.iss), was never installed:
+# the shortcuts showed a blank page instead of the application icon.
+if(WIN32)
+    install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/res/icons/desktopeditors-eo.ico"
+        DESTINATION ${CMAKE_INSTALL_BINDIR}
+        RENAME app.ico
+    )
+endif()
+
 # Boost: on Windows it's static (linked into the binaries) — nothing to install
 if(NOT WIN32)
     install(DIRECTORY "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/boost/linux_64/lib/"
