+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/res/uithemes")
+    install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/res/uithemes/"
+        DESTINATION ${CMAKE_INSTALL_BINDIR}/uithemes
+        FILES_MATCHING PATTERN "*.json"
+    )
+endif()
