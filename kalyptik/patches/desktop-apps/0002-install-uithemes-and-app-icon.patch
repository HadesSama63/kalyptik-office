+# Kalyptik: bundled free fonts (dyslexia, school) → fonts/, scanned at startup
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/res/kalyptik-fonts")
+    install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/res/kalyptik-fonts/"
+        DESTINATION ${CMAKE_INSTALL_BINDIR}/fonts
+    )
+endif()
