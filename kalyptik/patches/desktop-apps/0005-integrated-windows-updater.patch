+void sendKalyptikUpdateState(const QString& state, const QString& message = QString(), int progress = -1)
+{
+    QJsonObject data{{"state", state}, {"message", message}};
+    if (progress >= 0)
+        data.insert("progress", progress);
+    CAscApplicationManagerWrapper::sendCommandTo(
+        static_cast<QCefView *>(nullptr),
+        QStringLiteral("app:update"),
+        QString::fromUtf8(QJsonDocument(data).toJson(QJsonDocument::Compact)));
+}
+
+QString quotePowerShell(const QString& value)
+{
+    QString escaped = value;
+    escaped.replace(QLatin1Char('\''), QStringLiteral("''"));
+    return QStringLiteral("'") + escaped + QLatin1Char('\'');
+}
+}
