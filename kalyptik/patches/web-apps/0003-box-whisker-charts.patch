diff --git a/apps/spreadsheeteditor/main/app/view/BoxWhiskerDialog.js b/apps/spreadsheeteditor/main/app/view/BoxWhiskerDialog.js
new file mode 100644
index 0000000000..c68d4d84ff
--- /dev/null
+++ b/apps/spreadsheeteditor/main/app/view/BoxWhiskerDialog.js
@@ -0,0 +1,253 @@
+/*
