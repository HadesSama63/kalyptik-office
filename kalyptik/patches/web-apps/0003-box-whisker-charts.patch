+ */
+
+define([], function () { 'use strict';
+
+    SSE.Views.BoxWhiskerDialog = Common.UI.Window.extend(_.extend({
+        options: {
+            width: 520,
+            cls: 'modal-dlg',
+            buttons: ['ok', 'cancel']
+        },
+
+        initialize: function(options) {
+            _.extend(this.options, {
+                title: this.textTitle,
+                tpl: _.template([
+                    '<div class="box">',
+                        '<div style="margin-bottom:12px;">',
+                            '<label for="box-whisker-count">', this.textCount, '</label> ',
+                            '<select id="box-whisker-count" style="margin-left:8px;">',
+                                '<option value="1">1</option>',
+                                '<option value="2" selected>2</option>',
+                                '<option value="3">3</option>',
+                            '</select>',
+                        '</div>',
+                        '<div id="box-whisker-inputs"></div>',
+                        '<div id="box-whisker-error" role="alert" style="display:none;color:#c00;margin-top:10px;"></div>',
+                    '</div>'
+                ].join(''))()
+            }, options || {});
+
+            Common.UI.Window.prototype.initialize.call(this, this.options);
+        },
+
+        render: function() {
+            Common.UI.Window.prototype.render.call(this);
+            this.$inputHost = this.$window.find('#box-whisker-inputs');
+            this.$error = this.$window.find('#box-whisker-error');
+            this.$window.find('#box-whisker-count').on('change', _.bind(this.renderInputs, this));
+            this.$window.find('.dlg-btn').on('click', _.bind(this.onBtnClick, this));
+            this.renderInputs();
+            this.afterRender();
+        },
+
+        renderInputs: function() {
+            var count = Number(this.$window.find('#box-whisker-count').val());
+            var savedValues = {};
+            this.$inputHost.find('input').each(function() {
+                savedValues[this.getAttribute('data-box') + ':' + this.getAttribute('data-value')] = this.value;
+            });
+            var columns = [
+                {key: 'min', label: this.textMin},
+                {key: 'max', label: this.textMax},
+                {key: 'median', label: this.textMedian},
+                {key: 'q1', label: this.textQ1},
+                {key: 'q3', label: this.textQ3}
+            ];
+            var html = '<table style="width:100%;border-collapse:collapse;"><thead><tr><th></th>';
+            columns.forEach(function(column) {
+                html += '<th style="padding:4px;text-align:center;">' + column.label + '</th>';
+            });
+            html += '</tr></thead><tbody>';
+
+            for (var row = 0; row < count; row++) {
+                html += '<tr><th scope="row" style="padding:4px;text-align:left;">' +
+                    this.textBox + ' ' + (row + 1) + '</th>';
+                columns.forEach(function(column) {
+                    html += '<td style="padding:4px;"><input type="number" step="any" required ' +
+                        'data-box="' + row + '" data-value="' + column.key + '" ' +
+                        'aria-label="' + this.textBox + ' ' + (row + 1) + ' — ' + column.label + '" ' +
+                        'style="box-sizing:border-box;width:100%;"></td>';
+                }, this);
+                html += '</tr>';
+            }
+            html += '</tbody></table><div style="margin-top:8px;color:#666;">' +
+                this.textOrder + '</div>';
+            this.$inputHost.html(html);
+            this.$inputHost.find('input').each(function() {
+                var key = this.getAttribute('data-box') + ':' + this.getAttribute('data-value');
+                if (savedValues[key] !== undefined)
+                    this.value = savedValues[key];
+            });
+            this.$error.hide().text('');
+        },
+
+        onPrimary: function() {
+            return this.submit();
+        },
+
+        onBtnClick: function(event) {
+            var result = event.currentTarget.attributes.result.value;
+            if (result === 'ok')
+                this.submit();
+            else {
+                this.options.handler && this.options.handler.call(this, result);
+                this.close();
+            }
+        },
+
+        submit: function() {
+            var count = Number(this.$window.find('#box-whisker-count').val());
+            var boxes = [];
+            for (var index = 0; index < count; index++) {
+                var values = {};
+                this.$inputHost.find('[data-box="' + index + '"]').each(function() {
+                    var input = this;
+                    values[input.getAttribute('data-value')] = input.value.trim() === '' ?
+                        NaN : Number(input.value);
+                });
+                if (!Object.keys(values).every(function(key) { return isFinite(values[key]); })) {
+                    this.showError(this.textInvalidNumber);
+                    return false;
+                }
+                if (!(values.min <= values.q1 && values.q1 <= values.median &&
+                    values.median <= values.q3 && values.q3 <= values.max)) {
+                    this.showError(this.textInvalidOrder);
+                    return false;
+                }
+                boxes.push(values);
+            }
+
+            this.options.handler && this.options.handler.call(this, 'ok', this.createImageData(boxes));
+            this.close();
+            return false;
+        },
+
+        createImageData: function(boxes) {
+            var low = Math.min.apply(null, boxes.map(function(box) { return box.min; }));
+            var high = Math.max.apply(null, boxes.map(function(box) { return box.max; }));
+            if (low === high) {
+                var padding = Math.abs(low) * 0.05 || 1;
+                low = Math.max(-Number.MAX_VALUE, low - padding);
+                high = Math.min(Number.MAX_VALUE, high + padding);
+            }
+
+            var scale = Math.max(Math.abs(low), Math.abs(high), 1);
+            var normalizedLow = low / scale;
+            var normalizedHigh = high / scale;
+            var width = 760;
+            var plotLeft = 120;
+            var plotRight = 730;
+            var plotTop = 42;
+            var rowStart = 65;
+            var rowStep = 66;
+            var axisY = rowStart + boxes.length * rowStep + 5;
+            var height = axisY + 43;
+            var x = function(value) {
+                return plotLeft + (value / scale - normalizedLow) *
+                    (plotRight - plotLeft) / (normalizedHigh - normalizedLow);
+            };
+            var numberLabel = function(value) {
+                var label = value.toPrecision(4);
+                if (label.indexOf('.') >= 0) {
+                    label = label.replace(/0+(e|$)/, '$1').replace(/\.(e|$)/, '$1');
+                }
+                return label;
+            };
+            var svg = [
+                '<svg xmlns="http://www.w3.org/2000/svg" width="', width, '" height="', height,
+                '" viewBox="0 0 ', width, ' ', height, '">',
+                '<title>', this.textTitle, '</title>',
+                '<rect width="100%" height="100%" fill="#ffffff"/>',
+                '<text x="', width / 2, '" y="24" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" font-weight="600" fill="#333">', this.textTitle, '</text>'
+            ];
+
+            for (var tick = 0; tick <= 5; tick++) {
+                var ratio = tick / 5;
+                var normalizedTick = normalizedLow * (1 - ratio) + normalizedHigh * ratio;
+                normalizedTick = Math.max(normalizedLow, Math.min(normalizedHigh, normalizedTick));
+                var tickValue = normalizedTick * scale;
+                var tickX = x(tickValue);
+                svg.push(
+                    '<line x1="', tickX, '" y1="', plotTop, '" x2="', tickX, '" y2="', axisY,
+                    '" stroke="#e5e5e5" stroke-width="1"/>',
+                    '<text x="', tickX, '" y="', axisY + 18,
+                    '" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#555">',
+                    numberLabel(tickValue), '</text>'
+                );
+            }
+
+            boxes.forEach(function(box, index) {
+                var center = rowStart + index * rowStep;
+                var xMin = x(box.min);
+                var xQ1 = x(box.q1);
+                var xMedian = x(box.median);
+                var xQ3 = x(box.q3);
+                var xMax = x(box.max);
+                svg.push(
+                    '<text x="', plotLeft - 12, '" y="', center + 4,
+                    '" text-anchor="end" font-family="Arial,sans-serif" font-size="12" fill="#333">',
+                    this.textBox, ' ', index + 1, '</text>',
+                    '<line x1="', xMin, '" y1="', center, '" x2="', xQ1, '" y2="', center,
+                    '" stroke="#287c9e" stroke-width="2"/>',
+                    '<line x1="', xQ3, '" y1="', center, '" x2="', xMax, '" y2="', center,
+                    '" stroke="#287c9e" stroke-width="2"/>',
+                    '<line x1="', xMin, '" y1="', center - 11, '" x2="', xMin, '" y2="', center + 11,
+                    '" stroke="#287c9e" stroke-width="2"/>',
+                    '<line x1="', xMax, '" y1="', center - 11, '" x2="', xMax, '" y2="', center + 11,
+                    '" stroke="#287c9e" stroke-width="2"/>',
+                    '<rect x="', xQ1, '" y="', center - 14, '" width="', Math.max(1, xQ3 - xQ1),
+                    '" height="28" fill="#dceff7" stroke="#287c9e" stroke-width="2"/>',
+                    '<line x1="', xMedian, '" y1="', center - 14, '" x2="', xMedian, '" y2="', center + 14,
+                    '" stroke="#174e67" stroke-width="3"/>'
+                );
+            }, this);
+
+            svg.push(
+                '<line x1="', plotLeft, '" y1="', axisY, '" x2="', plotRight, '" y2="', axisY,
+                '" stroke="#777" stroke-width="1"/>',
+                '</svg>'
+            );
+            return 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svg.join(''))));
+        },
+
+        showError: function(message) {
+            this.$error.text(message).show();
+        },
+
+        textTitle: 'Box-and-whisker chart',
+        textCount: 'Number of boxes (1–3)',
+        textBox: 'Box',
+        textMin: 'Min',
+        textMax: 'Max',
+        textMedian: 'Median',
+        textQ1: 'Q1',
+        textQ3: 'Q3',
+        textOrder: 'Values must satisfy Min ≤ Q1 ≤ Median ≤ Q3 ≤ Max.',
+        textInvalidNumber: 'Enter a valid number in every field.',
+        textInvalidOrder: 'For each box, values must satisfy Min ≤ Q1 ≤ Median ≤ Q3 ≤ Max.'
+
+    }, SSE.Views.BoxWhiskerDialog || {}));
+});
